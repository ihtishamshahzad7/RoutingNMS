[Unit]
Description=RoutingNMS Web UI
After=network-online.target routingnms-api.service
Wants=network-online.target

[Service]
Type=simple
User=routingnms
Group=routingnms
WorkingDirectory=/opt/routingnms/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/routingnms

[Install]
WantedBy=multi-user.target
