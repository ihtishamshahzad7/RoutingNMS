APP_ENV=development
APP_PORT=8080

# Set to "true" once RoutingNMS is served over HTTPS so the session cookie
# gets the Secure flag. Leave "false" for a plain-HTTP deployment (the
# documented Ubuntu install) or the login cookie will be rejected by the
# browser.
COOKIE_SECURE=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routingnms
POSTGRES_USER=routingnms
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
VICTORIA_METRICS_URL=http://victoria-metrics:8428

# Syslog receiver (internal/syslog). Defaults to the standard port 514 --
# routingnms-api.service already grants CAP_NET_BIND_SERVICE so the service
# can bind it without running as root. Override SYSLOG_PORT (or set the
# full SYSLOG_ADDR, e.g. ":1514") for a non-systemd/dev setup that can't
# bind privileged ports.
# SYSLOG_PORT=514
# SYSLOG_ADDR=
# SYSLOG_RETENTION_DAYS=14
# SYSLOG_QUEUE_SIZE=5000
# SYSLOG_QUEUE_WORKERS=4
# SYSLOG_RATE_LIMIT_PER_SEC=50
# SYSLOG_RATE_BURST=200
# SYSLOG_DEVICE_CACHE_REFRESH_SECONDS=30

# Never commit real credentials or API keys.
AI_PROVIDER=
AI_API_KEY=
